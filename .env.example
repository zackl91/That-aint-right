# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Game settings ----
# Must match app_today() in supabase/schema.sql
NEXT_PUBLIC_APP_TIMEZONE=America/New_York
# Day #1 of the game (YYYY-MM-DD). Puzzle numbers count from here.
NEXT_PUBLIC_LAUNCH_DATE=2026-09-26
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@example.com

# ---- Content automation ----
# Free: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pay-as-you-go: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# flux-schnell is ~$0.003/image. For more convincing fakes try black-forest-labs/flux-1.1-pro (~$0.04).
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Optional but recommended: writes better prompts, spots the AI "tells", picks subjects
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# How many days ahead the daily cron builds puzzles (gives you time to review in /admin)
CONTENT_LEAD_DAYS=2
# true = new puzzles go live automatically; false = they wait for you to publish in /admin
AUTO_PUBLISH=true
# Vercel sends this as a Bearer token to the cron route. Any long random string.
CRON_SECRET=
